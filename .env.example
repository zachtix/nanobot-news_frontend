# Nanobot member API — the sign-in page calls it directly, as member-frontend does
# (same values as VITE_API_URL_MEMBER / VITE_API_KEY_MEMBER in member-frontend)
# Staging: https://api.nanobotpro.com/member · production: https://api.nanobot.app
VITE_API_URL_MEMBER=https://api.nanobotpro.com/member
VITE_API_KEY_MEMBER=

# Backend URL when not using the dev proxy (default: same origin, /api)
# VITE_API_URL=
